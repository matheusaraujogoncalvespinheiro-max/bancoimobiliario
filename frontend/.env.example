# Copie este arquivo para `.env` e preencha com os dados do seu projeto Firebase.
# Console do Firebase > Configurações do projeto > Seus apps > Web.
# O Firebase só é usado se VITE_FIREBASE_PROJECT_ID e VITE_FIREBASE_API_KEY estiverem preenchidos.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=